# 68 RIDERS - ENVIRONMENT CONFIGURATION
# ==========================================
# 1. Copy this file to .env.development for local development
# 2. Configure production values in Vercel/hosting environment variables
# 3. Never commit real credentials to git

# Supabase Configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Push Notifications (Generate: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
VITE_ENABLE_DEBUG_PANEL=true
VITE_ENABLE_MOCK_DATA=true
# Keep false in production. Set true only for local UI testing without Supabase.
VITE_DEMO_ADMIN=false

# API Configuration
VITE_API_TIMEOUT=30000
VITE_MAX_UPLOAD_SIZE=10485760
VITE_ENABLE_RATE_LIMITING=false

# Monitoring (Optional)
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=

# Environment
VITE_APP_ENV=development
VITE_APP_VERSION=2.0.0

# Supabase Edge Function secret only. Do not expose this in Vite/client env.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@68riders.com.tr
